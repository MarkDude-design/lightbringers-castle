{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightbringers.example/specs/team/model-capability.schema.json",
  "title": "Observed Model Capability Record",
  "type": "object",
  "properties": {
    "schema_version": {"const": "model-capability/0.1"},
    "requested_model": {"type": "string", "minLength": 1},
    "observed_model_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "catalog_checked_at": {"type": "string", "format": "date-time"},
    "advertised_parameters": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provider_require_parameters": {"const": true},
    "tool_catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hello_ack": {"$ref": "#/$defs/probe"},
    "digest24": {"$ref": "#/$defs/probe"},
    "max_verified_questions": {"type": "integer", "minimum": 0, "maximum": 40},
    "usage_receipts_present": {"type": "boolean"},
    "cost_class": {"type": "string", "enum": ["free", "paid", "unknown"]},
    "notes": {"type": "string", "maxLength": 2000}
  },
  "required": ["schema_version", "requested_model", "observed_model_ids", "catalog_checked_at", "advertised_parameters", "provider_require_parameters", "tool_catalog_sha256", "hello_ack", "digest24", "max_verified_questions", "usage_receipts_present", "cost_class", "notes"],
  "additionalProperties": false,
  "$defs": {
    "probe": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["pass", "fail", "stale", "not_run"]},
        "tested_at": {"type": ["string", "null"], "format": "date-time"},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "failure_code": {"type": ["string", "null"], "maxLength": 64}
      },
      "required": ["status", "tested_at", "artifact_sha256", "failure_code"],
      "additionalProperties": false
    }
  }
}
